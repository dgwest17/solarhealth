+export const getRateDefaults = (utility, planId = null) => {
+  if (planId && RATE_PLANS[planId]) return fromPlan(RATE_PLANS[planId]);
+  return UTILITY_RATE_DEFAULTS[utility] || UTILITY_RATE_DEFAULTS.SDGE;
+};
