+/**
+ * FILE: src/project/IntakeForm.jsx
+ *
+ * INTAKE — the details the installer needs before anyone visits.
+ *
+ * Everything asked here is something the homeowner knows and the contractor
+ * cannot find out without a phone call. Anything derivable from the proposal
+ * or the CRM is NOT asked: system size, battery model, address, financing are
+ * all attached automatically on submit. A form that asks for what you already
+ * know teaches people to rush it.
+ *
+ * The field list is deliberately shaped to become spreadsheet columns. Dave is
+ * sending the contractor's sheet; when it lands, the mapping is one object in
+ * api/intake.js rather than a rebuild here, because `INTAKE_FIELDS` already
+ * carries a stable `key` per answer.
+ *
+ * Rendered by: src/project/ProjectSteps.jsx (as a modal)
+ */
+import React, { useState } from 'react';
+import { SURF, GRADIENTS } from '../surf/theme';
+import { apiFetch } from '../lib/supabaseClient';
+
+/**
+ * The questions. Grouped the way a homeowner thinks about their house, not
+ * the way an installer files it.
+ */
+export const INTAKE_FIELDS = [
+  {
+    group: 'Getting in',
+    fields: [
+      { key: 'access_notes', label: 'Anything tricky about getting to your electrical panel?',
+        type: 'textarea', placeholder: 'Locked gate, dog, side yard access, parking…' },
+      { key: 'gate_code', label: 'Gate or lock code, if any', type: 'text' },
+      { key: 'preferred_contact', label: 'Best way to reach you on the day', type: 'select',
+        options: ['Call', 'Text', 'Email'] },
+      { key: 'contact_phone', label: 'Best number', type: 'tel' }
+    ]
+  },
+  {
+    group: 'Your electrical',
+    fields: [
+      { key: 'panel_location', label: 'Where is your main electrical panel?', type: 'select',
+        options: ['Outside — side of house', 'Outside — front', 'Outside — back', 'Inside — garage', 'Inside — utility room', 'Not sure'] },
+      { key: 'panel_amps', label: 'Main breaker size, if you can read it', type: 'select',
+        options: ['100A', '125A', '150A', '200A', '400A', 'Not sure'] },
+      { key: 'sub_panel', label: 'Is there a sub-panel?', type: 'select',
+        options: ['No', 'Yes', 'Not sure'] },
+      { key: 'battery_location', label: 'Where would you like the battery?', type: 'select',
+        options: ['Garage — interior wall', 'Garage — exterior wall', 'Outside — side of house', 'Outside — back', 'Wherever you recommend'] }
+    ]
+  },
+  {
+    group: 'Your roof',
+    fields: [
+      { key: 'roof_age', label: 'Roughly how old is the roof?', type: 'select',
+        options: ['Under 5 years', '5–10 years', '10–20 years', 'Over 20 years', 'Not sure'] },
+      { key: 'roof_type', label: 'Roof material', type: 'select',
+        options: ['Composition shingle', 'Tile — concrete', 'Tile — clay', 'Metal', 'Flat / TPO', 'Not sure'] },
+      { key: 'roof_issues', label: 'Any known leaks or repairs planned?', type: 'textarea' },
+      { key: 'stories', label: 'How many storeys?', type: 'select', options: ['1', '2', '3+'] }
+    ]
+  },
+  {
+    group: 'Scheduling',
+    fields: [
+      { key: 'hoa', label: 'Is there an HOA?', type: 'select', options: ['No', 'Yes', 'Not sure'] },
+      { key: 'availability', label: 'Days and times that work best', type: 'textarea',
+        placeholder: 'Weekday mornings, after 3pm, etc.' },
+      { key: 'notes', label: 'Anything else we should know?', type: 'textarea' }
+    ]
+  }
+];
+
+const IntakeForm = ({ proposal, contactId, projectId, onClose, onSubmitted }) => {
+  const [answers, setAnswers] = useState({});
+  const [sending, setSending] = useState(false);
+  const [error, setError] = useState('');
+  const [sent, setSent] = useState(false);
+
+  const set = (k, v) => setAnswers((a) => ({ ...a, [k]: v }));
+
+  const submit = async () => {
+    setSending(true); setError('');
+    try {
+      const r = await apiFetch('/api/intake', {
+        method: 'POST',
+        body: JSON.stringify({ contactId, projectId, answers, proposal })
+      });
+      if (!r.ok) throw new Error(r.error || 'Could not send.');
+      setSent(true);
+      setTimeout(() => onSubmitted && onSubmitted(), 1200);
+    } catch (e) {
+      setError(e.message);
+    } finally {
+      setSending(false);
+    }
+  };
+
+  return (
+    <div
+      className="fixed inset-0 z-50 flex items-start justify-center overflow-y-auto p-4"
+      style={{ background: 'rgba(3,18,27,.86)' }}
+      onClick={(e) => { if (e.target === e.currentTarget) onClose && onClose(); }}
+    >
+      <div className="w-full max-w-2xl my-8 rounded-3xl overflow-hidden"
+           style={{ background: SURF.abyss, border: `1px solid ${SURF.lineStrong}` }}>
+        <div className="p-6" style={{ background: GRADIENTS.barrelSoft }}>
+          <h2 className="text-2xl font-bold" style={{ color: '#fff' }}>A few details about your home</h2>
+          <p className="text-[13px] mt-1.5 max-w-[52ch]" style={{ color: 'rgba(255,255,255,.85)' }}>
+            Five minutes, and it saves your installer a phone call. Skip anything you are unsure about —
+            &ldquo;not sure&rdquo; is a real answer and better than a guess.
+          </p>
+        </div>
+
+        {sent ? (
+          <div className="p-12 text-center">
+            <div className="text-4xl mb-3">✓</div>
+            <div className="text-xl font-bold" style={{ color: SURF.good }}>Sent.</div>
+            <p className="text-[13.5px] mt-2" style={{ color: SURF.textMuted }}>
+              Your installer has everything they need to schedule.
+            </p>
+          </div>
+        ) : (
+          <>
+            <div className="p-6 space-y-7">
+              {INTAKE_FIELDS.map((group) => (
+                <div key={group.group}>
+                  <h3 className="text-[12px] uppercase tracking-[0.18em] font-semibold mb-3 pb-2"
+                      style={{ color: SURF.seaBright, borderBottom: `1px solid ${SURF.line}` }}>
+                    {group.group}
+                  </h3>
+                  <div className="space-y-4">
+                    {group.fields.map((f) => (
+                      <div key={f.key}>
+                        <label className="block text-[13px] mb-1.5" style={{ color: SURF.text }}>
+                          {f.label}
+                        </label>
+                        {f.type === 'textarea' ? (
+                          <textarea
+                            rows={2} value={answers[f.key] || ''} placeholder={f.placeholder || ''}
+                            onChange={(e) => set(f.key, e.target.value)}
+                            className="w-full px-3 py-2 rounded-lg text-[14px]"
+                            style={{ background: SURF.deep, border: `1px solid ${SURF.line}`, color: SURF.textBright }}
+                          />
+                        ) : f.type === 'select' ? (
+                          <select
+                            value={answers[f.key] || ''} onChange={(e) => set(f.key, e.target.value)}
+                            className="w-full px-3 py-2 rounded-lg text-[14px]"
+                            style={{ background: SURF.deep, border: `1px solid ${SURF.line}`, color: SURF.textBright }}
+                          >
+                            <option value="">Choose…</option>
+                            {f.options.map((o) => <option key={o} value={o}>{o}</option>)}
+                          </select>
+                        ) : (
+                          <input
+                            type={f.type} value={answers[f.key] || ''} placeholder={f.placeholder || ''}
+                            onChange={(e) => set(f.key, e.target.value)}
+                            className="w-full px-3 py-2 rounded-lg text-[14px]"
+                            style={{ background: SURF.deep, border: `1px solid ${SURF.line}`, color: SURF.textBright }}
+                          />
+                        )}
+                      </div>
+                    ))}
+                  </div>
+                </div>
+              ))}
+
+              {error && (
+                <div className="rounded-lg p-3 text-[12.5px]"
+                     style={{ background: 'rgba(209,88,74,.15)', color: '#f6c9c3' }}>{error}</div>
+              )}
+            </div>
+
+            <div className="p-6 pt-0 flex items-center justify-between gap-3">
+              <button onClick={onClose} className="text-[13px]" style={{ color: SURF.textMuted }}>
+                Finish later
+              </button>
+              <button
+                onClick={submit} disabled={sending}
+                className="px-6 py-3 rounded-xl text-[14px] font-bold"
+                style={{
+                  background: sending ? SURF.surface : SURF.sun,
+                  color: sending ? SURF.textMuted : SURF.abyss
+                }}
+              >{sending ? 'Sending…' : 'Send to my installer'}</button>
+            </div>
+          </>
+        )}
+      </div>
+    </div>
+  );
+};
+
+export default IntakeForm;
